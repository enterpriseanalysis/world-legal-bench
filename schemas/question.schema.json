{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "World Legal Bench question",
  "required": [
    "id",
    "revision",
    "country",
    "language",
    "question",
    "choices",
    "task_family",
    "knowledge_family",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "language": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "B": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "task_family": {
      "type": "string"
    },
    "knowledge_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
